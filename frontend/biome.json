{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!wailsjs",
      "!public",
      "!**/node_modules",
      "!**/dist",
      "!**/.next",
      "!**/build",
      "!**/coverage",
      "!**/generated",
      "!**/.turbo",
      "!**/.venv",
      "!**/playwright-report",
      "!**/test-results",
      "!**/*.dc.html",
      "!**/*.min.js",
      "!**/vendor",
      "!**/public/pagefind",
      "!**/dist-release"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "preset": "all",
        "noSolidDestructuredProps": "off",
        "useQwikValidLexicalScope": "off",
        "useImportExtensions": "off"
      },
      "suspicious": { "preset": "all", "noReactSpecificProps": "off" },
      "security": { "preset": "all" },
      "a11y": { "preset": "all" },
      "performance": {
        "preset": "all",
        "useSolidForComponent": "off",
        "noJsxPropsBind": "off",
        "noImgElement": "off",
        "noAwaitInLoops": "off"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/test/**",
        "**/__tests__/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off",
            "noUnresolvedImports": "off"
          },
          "security": { "noSecrets": "off" },
          "performance": { "noAwaitInLoops": "off", "useTopLevelRegex": "off" },
          "suspicious": {
            "noBitwiseOperators": "off",
            "noMisplacedAssertion": "off",
            "noSkippedTests": "off",
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/e2e/**",
        "**/playwright.config.ts",
        "**/playwright.*.config.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off",
            "noUnresolvedImports": "off"
          },
          "security": { "noSecrets": "off" },
          "performance": { "noAwaitInLoops": "off", "useTopLevelRegex": "off" },
          "suspicious": { "noConsole": "off" }
        }
      }
    },
    {
      "includes": [
        "**/scripts/**",
        "**/tools/**",
        "**/*.config.ts",
        "**/*.config.mjs",
        "**/*.config.js"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off",
            "noUnresolvedImports": "off"
          },
          "performance": { "useTopLevelRegex": "off" },
          "suspicious": { "noConsole": "off" }
        }
      }
    },
    {
      "includes": ["**/src/store.ts"],
      "linter": {
        "rules": {
          "correctness": { "noUnresolvedImports": "off" }
        }
      }
    },
    {
      "includes": [
        "**/src/server/**",
        "**/apps/server/**",
        "**/apps/worker/**",
        "**/app/**/route.ts",
        "**/src/app/api/**"
      ],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "off", "noProcessGlobal": "off" }
        }
      }
    }
  ]
}
