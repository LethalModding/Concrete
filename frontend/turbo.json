{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": ["biome.json", "tsconfig.json"],
  "globalEnv": [],
  "globalPassThroughEnv": ["CI", "HOME", "NO_COLOR", "PATH"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": { "inputs": ["$TURBO_DEFAULT$"], "outputs": [] },
    "typecheck": { "inputs": ["$TURBO_DEFAULT$"], "outputs": ["*.tsbuildinfo"] }
  }
}
